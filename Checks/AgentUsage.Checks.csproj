<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AgentUsage.csproj" />
    <Reference Include="Notch.Core">
      <HintPath Condition="'$(NotchCorePath)' != ''">$(NotchCorePath)</HintPath>
      <HintPath Condition="'$(NotchCorePath)' == ''">$(LocalAppData)\Programs\Notch\Notch.Core.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
